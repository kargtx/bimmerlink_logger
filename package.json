{
  "name": "bimmerlink-logger-web",
  "version": "2.1.0",
  "private": true,
  "description": "Веб-приложение для просмотра и анализа логов BimmerLink. Сделано для BMW102.",
  "main": "server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test \"test/**/*.test.js\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "reparse": "node scripts/reparse.js",
    "backup": "node scripts/backup.js"
  },
  "dependencies": {
    "@fontsource/fira-sans-condensed": "^5.3.0",
    "@fontsource/golos-text": "^5.3.0",
    "better-sqlite3": "^13.0.3",
    "csv-parse": "^7.0.3",
    "express": "^4.22.3",
    "helmet": "^8.3.0",
    "multer": "^2.5.0",
    "uplot": "^1.6.32"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10"
  }
}
